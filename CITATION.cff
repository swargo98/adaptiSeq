    given-names: "Rasman Mubtasim"
    # orcid: "https://orcid.org/0000-0000-0000-0000"
repository-code: "https://github.com/swargo98/adaptiSeq"
url: "https://swargo98.github.io/adaptiSeq/"
license: MIT
version: "0.1.4"
# date-released: "YYYY-MM-DD"   # set on the day 0.1.4 is tagged
